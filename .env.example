# Urban Carbon Sink — runtime secrets template.
# Copy to `.env` and fill in real values. `.env` is git-ignored and injected
# into the container at runtime (docker-compose env_file) — never baked in.

# --- Copernicus Data Space (CDSE) Sentinel Hub: OAuth2 client credentials -----
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Copernicus Atmosphere Data Store (CAMS): Personal Access Token -----------
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=

# --- Google Earth Engine: service-account key ---------------------------------
# Path to the key INSIDE the container (mounted read-only by docker-compose).
GEE_SERVICE_ACCOUNT_JSON=/run/secrets/gee_key.json

# --- Discord webhook: monthly run notifications -------------------------------
DISCORD_WEBHOOK_URL=

# --- GitHub (optional) --------------------------------------------------------
# Publishing runs on the host via `gh` (default: `gh auth login`). Export a
# token here only if you prefer it over the gh config file; the wrapper picks up
# GH_TOKEN / GITHUB_TOKEN automatically.
GITHUB_TOKEN=
